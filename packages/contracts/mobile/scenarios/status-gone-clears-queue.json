{
  "version": 1,
  "id": "status-gone-clears-queue",
  "capability": "delivery",
  "config": {
    "now": "2026-09-01T12:00:00.000Z",
    "platform": "ios",
    "appVersion": "1.0.0"
  },
  "actions": [
    {
      "op": "track",
      "name": "saved"
    },
    {
      "op": "network",
      "response": {
        "kind": "http",
        "status": 410
      }
    },
    {
      "op": "flush"
    },
    {
      "op": "track",
      "name": "after_gone"
    },
    {
      "op": "restart"
    },
    {
      "op": "track",
      "name": "after_restart"
    },
    {
      "op": "flush"
    },
    {
      "op": "resume"
    }
  ],
  "expect": {
