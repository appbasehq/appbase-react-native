              "platform": "ios",
              "app_version": "1.0.0",
              "properties": {}
            },
            {
              "schema_version": 1,
              "event_id": "$uuid:saved",
              "installation_id": "$uuid:installation",
              "anonymous_id": "$uuid:anonymous",
              "name": "saved",
              "occurred_at": "2026-09-01T12:00:00.000Z",
              "platform": "ios",
              "app_version": "1.0.0",
              "properties": {}
            }
          ]
        }
      }
    ],
    "status": {
      "queued": 0,
